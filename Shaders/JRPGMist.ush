// JRPGMist.ush
// Densidade da névoa viva (JRPGMist), avaliada por froxel dentro da Volumetric Fog.
//
// Chamado pelo Custom node do M_JRPGMist (domínio Volume). Receita do material em
// Docs/Guides/MIST.md. O resultado vai para Extinction; o segundo canal é a máscara das
// faixas, usada para o brilho opcional (Emissive).
//
// Unidades: tudo em uu do mundo, exceto onde dito. A névoa é pensada para câmera de cima,
// então o ruído é amostrado em XY do mundo e a altura vira só uma máscara.
//
// Custo por froxel: 4 SampleLevel do ruído (warp, base, fios, cobertura) + loop de 8 slots
// (só ALU). O distance field, quando ligado no material, chega pronto como entrada
// (1 amostra do Global DF + gradiente).
//
// Volumetric fog não tem derivadas confiáveis: sempre SampleLevel com mip 0.

#pragma once

#define JRPG_MIST_SLOTS 8

// Gira v pelo ângulo a (radianos)
float2 JRPGMistRotate(float2 v, float a)
{
	float s, c;
	sincos(a, s, c);
	return float2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Interação com quem mexe a névoa (jogador, NPCs, props).
// Slot[i] = (X, Y, Raio, Força)  — força já inclui idade do rastro e velocidade.
// Dir[i]  = (DirX, DirY, Giro, 0) — direção normalizada do movimento e escala do redemoinho.
// Devolve o deslocamento em uu a aplicar na coordenada do ruído (redemoinho) e, em OutClear,
// o quanto a névoa abre neste ponto (0..1).
float2 JRPGMistDisturb(float2 WorldXY, float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS],
	float SwirlStrength, out float OutClear)
{
	float2 Offset = 0;
	OutClear = 0;

	[unroll]
	for (int i = 0; i < JRPG_MIST_SLOTS; i++)
	{
		const float4 S = Slot[i];
		if (S.w <= 0.0) continue;

		const float2 D = WorldXY - S.xy;
		const float R = max(S.z, 1.0);
		const float G = exp(-dot(D, D) / (R * R)) * S.w;

		OutClear = max(OutClear, G);

		// Lado do eixo do movimento: cada lado gira para um sentido, formando o par de
		// vórtices de uma esteira. O giro vai a zero suavemente no eixo — um sign() aqui
		// rasga a névoa numa linha reta ao longo do rastro. Sem direção (parado), não gira.
		const float Side = (Dir[i].x * D.y - Dir[i].y * D.x) / R;
		const float Angle = SwirlStrength * Dir[i].z * G * clamp(Side * 1.5, -1.0, 1.0);
		Offset += JRPGMistRotate(D, Angle) - D;
	}
	return Offset;
}

// Avaliação principal. Devolve (densidade, máscara das faixas).
//
// Forma = névoa base larga e suave + fios finos esticados na direção do vento, presentes
// só em parte da área (RibbonCoverage). Fios em todo lugar viram mármore.
float2 JRPGMistEvaluate(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	// forma
	float FloorZ, float Density, float HeightFalloff, float NoiseScale, float2 Wind,
	float WarpStrength, float WarpSpin, float RibbonSharpness, float RibbonAmount,
	float RibbonStretch, float RibbonCoverage,
	// caixa: (MinX, MinY, MaxX, MaxY) e largura do esmaecimento nas bordas
	float4 BoxXY, float EdgeFade,
	// cenário (distance field). Sem DF: SurfaceDist grande e SurfaceGrad 0.
	float SurfaceDist, float3 SurfaceGrad, float PoolDistance, float PoolAmount, float FlowAround,
	// interação
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS], float ClearStrength, float SwirlStrength)
{
	const float Scale = max(NoiseScale, 1.0);

	// 1) Interação: redemoinho em volta de quem passa e abertura da névoa
	float Clear;
	const float2 SwirlOffset = JRPGMistDisturb(WorldPos.xy, Slot, Dir, SwirlStrength, Clear);
	const float2 P = (WorldPos.xy + SwirlOffset) / Scale;
	const float2 Drift = Wind * Time / Scale;

	// 2) Cenário: perto de uma superfície o fluxo corre pela tangente dela (contorna a casa
	// em vez de atravessar) e a névoa se acumula na base
	const float Near = saturate(1.0 - SurfaceDist / max(PoolDistance, 1.0));
	// O gradiente chega cru (DistanceFieldGradient): normaliza aqui, porque longe das
	// superfícies ele é zero e Normalize no grafo daria NaN
	const float2 GradXY = SurfaceGrad.xy;
	const float GradLen = length(GradXY);
	const float2 GradDir = GradLen > 1e-4 ? GradXY / GradLen : float2(0.0, 0.0);
	const float2 Tangent = float2(-GradDir.y, GradDir.x);

	// 3) Domain warp: um campo lento (R/G independentes) desloca todas as amostras e gira
	// devagar. É isso que transforma o ruído em redemoinhos.
	float2 Warp = NoiseTex.SampleLevel(NoiseTexSampler, P * 0.5 + Drift * 0.5, 0).rg * 2.0 - 1.0;
	Warp = JRPGMistRotate(Warp, Time * WarpSpin);
	Warp += Tangent * (FlowAround * Near);
	const float2 Q = P + Warp * WarpStrength;

	// 4) Névoa base: larga e suave
	const float Base = smoothstep(0.2, 0.8, NoiseTex.SampleLevel(NoiseTexSampler, Q * 0.6 + Drift, 0).r);

	// 5) Fios: ruído esticado ao longo do vento + ridge, que realça onde o ruído cruza o meio
	const float WindLen = length(Wind);
	const float2 WindDir = WindLen > 0.001 ? Wind / WindLen : float2(1.0, 0.0);
	const float2 WindPerp = float2(-WindDir.y, WindDir.x);
	const float Along = dot(Q, WindDir) / max(RibbonStretch, 1.0);
	const float Across = dot(Q, WindPerp);
	const float2 R = (Along * WindDir + Across * WindPerp) * 1.5;
	const float N = NoiseTex.SampleLevel(NoiseTexSampler, R + Drift, 0).r;
	const float Ribbon = pow(saturate(1.0 - abs(2.0 * N - 1.0)), max(RibbonSharpness, 0.01));
	const float Coverage = smoothstep(1.0 - saturate(RibbonCoverage), 1.0,
		NoiseTex.SampleLevel(NoiseTexSampler, Q * 0.3 - Drift * 0.2 + 0.5, 0).g);
	const float Strands = Ribbon * Coverage;

	const float Shape = Base * (1.0 - 0.5 * saturate(RibbonAmount)) + Strands * RibbonAmount;

	// 6) Rente ao chão
	const float Height = exp(-max(WorldPos.z - FloorZ, 0.0) / max(HeightFalloff, 1.0));

	// 7) Não atravessa paredes (DF ~0 dentro/na superfície) e acumula perto delas
	const float Solid = saturate(SurfaceDist * 0.1);
	const float Pool = 1.0 + PoolAmount * Near;

	// 8) Bordas laterais da caixa: sem isto a névoa termina num "muro" reto
	const float EdgeDist = min(min(WorldPos.x - BoxXY.x, BoxXY.z - WorldPos.x),
	                           min(WorldPos.y - BoxXY.y, BoxXY.w - WorldPos.y));
	const float Edge = smoothstep(0.0, 1.0, saturate(EdgeDist / max(EdgeFade, 1.0)));

	const float Open = 1.0 - saturate(Clear * ClearStrength);
	const float Result = max(Density * Shape * Height * Pool * Solid * Open * Edge, 0.0);
	return float2(Result, Strands * Height * Open * Edge);
}

// Entrada usada pelo Custom node do M_JRPGMist: os escalares chegam empacotados em vetores,
// na mesma ordem que AJRPGMistVolume::ApplyMistParameters escreve.
//   ShapeA      = FloorZ, Density, HeightFalloff, NoiseScale
//   ShapeB      = WindX, WindY, WarpStrength, WarpSpin
//   Ribbons     = Sharpness, Amount, Stretch, Coverage
//   Scene       = PoolDistance, PoolAmount, FlowAround, EdgeFade
//   BoxXY       = MinX, MinY, MaxX, MaxY (caixa em XY do mundo)
//   Interaction = ClearStrength, SwirlStrength, -, -
float2 JRPGMistFromPacked(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	float4 ShapeA, float4 ShapeB, float4 Ribbons, float4 Scene, float4 Interaction, float4 BoxXY,
	float SurfaceDist, float3 SurfaceGrad,
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS])
{
	return JRPGMistEvaluate(WorldPos, Time, NoiseTex, NoiseTexSampler,
		ShapeA.x, ShapeA.y, ShapeA.z, ShapeA.w, ShapeB.xy, ShapeB.z, ShapeB.w,
		Ribbons.x, Ribbons.y, Ribbons.z, Ribbons.w,
		BoxXY, Scene.w,
		SurfaceDist, SurfaceGrad, Scene.x, Scene.y, Scene.z,
		Slot, Dir, Interaction.x, Interaction.y);
}

// Hash por linha (0..1), estável no tempo
float JRPGMistHash(float N)
{
	return frac(sin(N * 12.9898) * 43758.5453);
}

// Modo FlowLines: "fumaça de túnel de vento". Poucas linhas na direção do fluxo, curvando em
// S, com traços (trails) correndo por elas. Cabeça do traço na frente, cauda esmaecendo.
// As linhas desviam dos objetos pelo distance field e são entortadas por quem passa.
//
// Fluido fake, sem simulação: as curvas e os redemoinhos são ADVECTADOS — viajam correnteza
// abaixo com o fluxo em vez de ondular parados, que é o que faz parecer líquido. Uma camada
// de redemoinhos (ruído grande, também advectado) empurra as linhas e faz a largura respirar.
float2 JRPGMistFlowLines(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	float FloorZ, float Density, float HeightFalloff, float NoiseScale,
	float2 FlowDir, float FlowSpeed, float Spacing, float Width, float Coverage,
	float CurveAmount, float CurveLength, float CurveDrift,
	float EddyStrength, float EddyScale, float LineDensity,
	float DashLength, float DashFill,
	float4 BoxXY, float EdgeFade,
	float SurfaceDist, float3 SurfaceGrad, float PoolDistance, float FlowAround,
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS], float ClearStrength, float SwirlStrength)
{
	float Clear;
	const float2 SwirlOffset = JRPGMistDisturb(WorldPos.xy, Slot, Dir, SwirlStrength, Clear);

	const float DirLen = length(FlowDir);
	const float2 D = DirLen > 1e-4 ? FlowDir / DirLen : float2(1.0, 0.0);
	const float2 Perp = float2(-D.y, D.x);

	const float2 Pw = WorldPos.xy + SwirlOffset;
	const float Along = dot(Pw, D);
	float Across = dot(Pw, Perp);

	// Obstáculos: perto de uma superfície a linha é empurrada para o lado, contornando
	const float Near = saturate(1.0 - SurfaceDist / max(PoolDistance, 1.0));
	const float2 GradXY = SurfaceGrad.xy;
	const float GradLen = length(GradXY);
	const float2 GradDir = GradLen > 1e-4 ? GradXY / GradLen : float2(0.0, 0.0);
	Across -= dot(GradDir, Perp) * FlowAround * Near * PoolDistance;

	// Advecção: o campo das curvas e dos redemoinhos anda com o fluxo (metade da velocidade
	// dos traços, então os traços "correm" por dentro das curvas)
	const float Advect = Time * FlowSpeed * 0.5;
	const float Downstream = Along - Advect;

	// Curvas em S: dois senos com frequência e fase diferentes. Variam devagar na direção
	// transversal, então linhas vizinhas curvam juntas. Ruído de textura aqui fica serrilhado
	// (tem detalhe fino demais) — os senos dão curvas lisas e ainda são mais baratos.
	const float K = 6.2831853 / max(CurveLength, 1.0);
	const float Bend = 0.6 * sin(Downstream * K + Across * K * 0.35 + Time * CurveDrift)
	                 + 0.4 * sin(Downstream * K * 1.9 - Across * K * 0.5 + 1.7 - Time * CurveDrift * 0.7);
	Across += Bend * CurveAmount;

	// Redemoinhos: ruído em escala grande (o detalhe fino do fBm fica pequeno perto da
	// amplitude), advectado. Empurra as linhas de lado e estica/comprime os traços
	const float2 Eddy = NoiseTex.SampleLevel(NoiseTexSampler,
		float2(Downstream, Across) / max(EddyScale, 1.0), 0).rg * 2.0 - 1.0;
	Across += Eddy.x * EddyStrength;
	const float AlongW = Along + Eddy.y * EddyStrength * 0.5;

	// Linhas paralelas; cada uma tem sua presença, velocidade e fase. Perfil gaussiano com
	// largura em uu, que "respira" com o redemoinho
	const float LineCoord = Across / max(Spacing, 1.0);
	const float LineId = floor(LineCoord + 0.5);
	const float ToLine = abs(LineCoord - LineId) * max(Spacing, 1.0);
	const float W = max(Width, 1.0) * (0.6 + 0.8 * saturate(Eddy.y * 0.5 + 0.5));
	const float Line = exp(-(ToLine * ToLine) / (W * W));
	const float Present = saturate((saturate(Coverage) - JRPGMistHash(LineId)) * 20.0);
	const float Speed = FlowSpeed * (0.75 + 0.5 * JRPGMistHash(LineId + 17.0));

	// Traços correndo na direção do fluxo
	const float Phase = frac((AlongW - Time * Speed) / max(DashLength, 1.0) + JRPGMistHash(LineId + 41.0));
	const float Fill = clamp(DashFill, 0.05, 1.0);
	const float S = saturate(Phase / Fill);
	const float Streak = Phase < Fill ? S * S * (1.0 - smoothstep(0.9, 1.0, S)) : 0.0;

	const float Height = exp(-max(WorldPos.z - FloorZ, 0.0) / max(HeightFalloff, 1.0));
	const float Solid = saturate(SurfaceDist * 0.1);
	const float EdgeDist = min(min(WorldPos.x - BoxXY.x, BoxXY.z - WorldPos.x),
	                           min(WorldPos.y - BoxXY.y, BoxXY.w - WorldPos.y));
	const float Edge = smoothstep(0.0, 1.0, saturate(EdgeDist / max(EdgeFade, 1.0)));
	const float Open = 1.0 - saturate(Clear * ClearStrength);

	// As linhas cobrem pouco da área: 3x de densidade deixa o mesmo Density com peso visual
	// parecido nos dois modos
	const float Strand = Line * Present * Streak * Height * Edge * Open;
	return float2(max(Density * 3.0 * LineDensity * Strand * Solid, 0.0), Strand);
}


// Modo PulseRings: ondas circulares saindo do centro em pulsos (um anel a cada Interval
// segundos, viajando a Speed uu/s) e, opcionalmente, linhas radiais. Os anéis somem perto
// de MaxRadius; Wiggle entorta os anéis com ruído para não ficarem círculos perfeitos.
float2 JRPGMistPulseRings(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	float FloorZ, float Density, float HeightFalloff, float NoiseScale,
	float2 Center, float Speed, float Interval, float RingWidth, float Wiggle,
	float MaxRadius, float RadialCount, float RadialAmount, float RadialSharpness, float RadialSpin,
	float4 BoxXY, float EdgeFade, float SurfaceDist,
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS], float ClearStrength, float SwirlStrength)
{
	float Clear;
	const float2 SwirlOffset = JRPGMistDisturb(WorldPos.xy, Slot, Dir, SwirlStrength, Clear);

	const float2 D = WorldPos.xy + SwirlOffset - Center;
	float R = length(D);
	const float Angle = atan2(D.y, D.x);

	// Ondulação: desloca o raio por um ruído amostrado no ângulo e no tempo
	const float2 WiggleUV = float2(Angle * 0.159155 * 4.0, R / max(NoiseScale, 1.0) - Time * 0.05);
	R += (NoiseTex.SampleLevel(NoiseTexSampler, WiggleUV, 0).r * 2.0 - 1.0) * Wiggle;

	// Anéis: um a cada Interval segundos, então a distância entre anéis é Speed * Interval
	const float Spacing = max(Speed * max(Interval, 0.05), 1.0);
	const float Phase = frac((R - Time * Speed) / Spacing);
	const float ToRing = min(Phase, 1.0 - Phase) * Spacing;
	const float Width = max(RingWidth, 1.0);
	const float Ring = exp(-(ToRing * ToRing) / (Width * Width));

	// Linhas radiais girando devagar
	float Spokes = 0.0;
	if (RadialCount >= 1.0)
	{
		const float A = frac((Angle + Time * RadialSpin) * 0.159155 * floor(RadialCount));
		Spokes = pow(saturate(1.0 - abs(2.0 * A - 1.0)), max(RadialSharpness, 1.0)) * RadialAmount;
	}

	// Nasce suave no centro e some perto do raio máximo
	const float MaxR = max(MaxRadius, 1.0);
	const float Fade = smoothstep(0.0, Width * 2.0, R) * (1.0 - smoothstep(MaxR * 0.6, MaxR, R));

	const float Height = exp(-max(WorldPos.z - FloorZ, 0.0) / max(HeightFalloff, 1.0));
	const float Solid = saturate(SurfaceDist * 0.1);
	const float EdgeDist = min(min(WorldPos.x - BoxXY.x, BoxXY.z - WorldPos.x),
	                           min(WorldPos.y - BoxXY.y, BoxXY.w - WorldPos.y));
	const float Edge = smoothstep(0.0, 1.0, saturate(EdgeDist / max(EdgeFade, 1.0)));
	const float Open = 1.0 - saturate(Clear * ClearStrength);

	const float Shape = saturate(Ring + Spokes) * Fade * Height * Edge * Open;
	return float2(max(Density * 3.0 * Shape * Solid, 0.0), Shape);
}

// Entrada atual do Custom node (MF_JRPGMist): JRPGMistFromPacked + o modo e os parâmetros dos
// outros modos, na ordem que AJRPGMistVolume::ApplyMistParameters escreve. Os mesmos vetores
// mudam de significado com o modo:
//   Mode 0 GroundMist: Flow/FlowLines/FlowDash não são usados
//   Mode 1 FlowLines:  Flow      = Mode, DirX, DirY, FlowSpeed
//                      FlowLines = Spacing, Sharpness, Coverage, CurveAmount
//                      FlowDash  = DashLength, DashFill, AvoidDistance, AvoidStrength
//                      Interaction.zw = CurveLength, CurveDrift
//   Mode 2 PulseRings: Flow      = Mode, CenterX, CenterY, Speed
//                      FlowLines = Interval, RingWidth, MaxRadius, Wiggle
//                      FlowDash  = RadialCount, RadialAmount, RadialSharpness, RadialSpin
float2 JRPGMistFromPacked2(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	float4 ShapeA, float4 ShapeB, float4 Ribbons, float4 Scene, float4 Interaction, float4 BoxXY,
	float4 Flow, float4 FlowLines, float4 FlowDash,
	float SurfaceDist, float3 SurfaceGrad,
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS])
{
	if (Flow.x > 1.5)
	{
		return JRPGMistPulseRings(WorldPos, Time, NoiseTex, NoiseTexSampler,
			ShapeA.x, ShapeA.y, ShapeA.z, ShapeA.w,
			Flow.yz, Flow.w, FlowLines.x, FlowLines.y, FlowLines.w,
			FlowLines.z, FlowDash.x, FlowDash.y, FlowDash.z, FlowDash.w,
			BoxXY, Scene.w, SurfaceDist,
			Slot, Dir, Interaction.x, Interaction.y);
	}
	if (Flow.x > 0.5)
	{
		return JRPGMistFlowLines(WorldPos, Time, NoiseTex, NoiseTexSampler,
			ShapeA.x, ShapeA.y, ShapeA.z, ShapeA.w,
			Flow.yz, Flow.w, FlowLines.x, FlowLines.y, FlowLines.z,
			FlowLines.w, Interaction.z, Interaction.w,
			0.0, 1.0, 1.0,
			FlowDash.x, FlowDash.y,
			BoxXY, Scene.w,
			SurfaceDist, SurfaceGrad, FlowDash.z, FlowDash.w,
			Slot, Dir, Interaction.x, Interaction.y);
	}
	return JRPGMistFromPacked(WorldPos, Time, NoiseTex, NoiseTexSampler,
		ShapeA, ShapeB, Ribbons, Scene, Interaction, BoxXY, SurfaceDist, SurfaceGrad, Slot, Dir);
}

// Entrada atual do Custom node (MF_JRPGMist). JRPGMistFromPacked2 + FlowEddy e o modo 3.
//   Mode 3 GroundAndFlow: névoa de chão + flow lines somadas, com o mesmo vento (o C++ já
//                         escreve em ShapeB.xy o vento derivado da direção do fluxo)
//   FlowEddy  = EddyStrength, EddyScale, LineDensity, -   (modos 1 e 3)
//   FlowLines.y é a largura das linhas em uu
float2 JRPGMistFromPacked3(
	float3 WorldPos, float Time, Texture2D NoiseTex, SamplerState NoiseTexSampler,
	float4 ShapeA, float4 ShapeB, float4 Ribbons, float4 Scene, float4 Interaction, float4 BoxXY,
	float4 Flow, float4 FlowLines, float4 FlowDash, float4 FlowEddy,
	float SurfaceDist, float3 SurfaceGrad,
	float4 Slot[JRPG_MIST_SLOTS], float4 Dir[JRPG_MIST_SLOTS])
{
	const bool bPulse = Flow.x > 1.5 && Flow.x < 2.5;
	const bool bGround = Flow.x < 0.5 || Flow.x > 2.5;
	const bool bLines = (Flow.x > 0.5 && Flow.x < 1.5) || Flow.x > 2.5;

	if (bPulse)
	{
		return JRPGMistPulseRings(WorldPos, Time, NoiseTex, NoiseTexSampler,
			ShapeA.x, ShapeA.y, ShapeA.z, ShapeA.w,
			Flow.yz, Flow.w, FlowLines.x, FlowLines.y, FlowLines.w,
			FlowLines.z, FlowDash.x, FlowDash.y, FlowDash.z, FlowDash.w,
			BoxXY, Scene.w, SurfaceDist,
			Slot, Dir, Interaction.x, Interaction.y);
	}

	float2 Result = float2(0.0, 0.0);
	if (bGround)
	{
		Result += JRPGMistFromPacked(WorldPos, Time, NoiseTex, NoiseTexSampler,
			ShapeA, ShapeB, Ribbons, Scene, Interaction, BoxXY, SurfaceDist, SurfaceGrad, Slot, Dir);
	}
	if (bLines)
	{
		Result += JRPGMistFlowLines(WorldPos, Time, NoiseTex, NoiseTexSampler,
			ShapeA.x, ShapeA.y, ShapeA.z, ShapeA.w,
			Flow.yz, Flow.w, FlowLines.x, FlowLines.y, FlowLines.z,
			FlowLines.w, Interaction.z, Interaction.w,
			FlowEddy.x, FlowEddy.y, FlowEddy.z,
			FlowDash.x, FlowDash.y,
			BoxXY, Scene.w,
			SurfaceDist, SurfaceGrad, FlowDash.z, FlowDash.w,
			Slot, Dir, Interaction.x, Interaction.y);
	}
	return Result;
}
